<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH 端口助手" Width="960" Height="850" MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#F3F6FB"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#15243B">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D6DFEC"/>
      <Setter Property="Foreground" Value="#284464"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.83"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="BorderBrush" Value="#CCD7E6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/>
    </Style>
  </Window.Resources>
  <Grid Margin="30,25,30,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="SSH 端口助手" FontWeight="SemiBold" FontSize="28"/>
        <TextBlock Text="启动远端工作区并同步端口，或手动更新 SSH 连接。" Foreground="#61748D" Margin="0,7,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#E5EEFF" CornerRadius="8" Padding="13,9" VerticalAlignment="Center">
        <TextBlock Text="36.140.239.91" Foreground="#235EC4" FontFamily="Consolas" FontSize="15"/>
      </Border>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,4,0">
        <Border Background="White" BorderBrush="#E0E7F0" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="本机 SSH 配置" FontWeight="SemiBold"/>
              <TextBlock x:Name="ConfigPathText" Foreground="#61748D" Margin="0,7,14,0" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ManageHostsButton" Content="管理主机与映射" Margin="0,0,9,0"/>
              <Button x:Name="RefreshButton" Content="刷新配置"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Background="White" BorderBrush="#D6E2F5" BorderThickness="1" CornerRadius="12" Padding="20,17" Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="自动启动并同步" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="选择本机 SSH 主机，启动对应的 Coder 工作区并获取最新端口。" Foreground="#61748D" Margin="0,7,0,12" TextWrapping="Wrap"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid Margin="0,0,12,0">
                <ComboBox x:Name="AutoHostComboBox" DisplayMemberPath="DisplayName" MinHeight="43" Padding="10,7" VerticalContentAlignment="Center" AutomationProperties.Name="自动启动的 SSH 主机"/>
                <TextBlock x:Name="AutoSelectionPlaceholder" Text="请选择 SSH 主机 → Coder 工作区" Foreground="#728198" Margin="13,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <Button x:Name="StartSyncButton" Grid.Column="1" Content="启动并同步端口" Background="#2864DC" BorderBrush="#2864DC" Foreground="White" FontWeight="SemiBold" IsEnabled="False"/>
            </Grid>
            <TextBlock x:Name="AutoHintText" Text="仅处理所选主机；获取端口后将请求管理员授权并自动同步。" Foreground="#61748D" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="CredentialStatusText" Text="正在读取登录凭据…" Foreground="#526780" FontSize="12" Margin="0,13,0,0" TextWrapping="Wrap"/>
            <Expander x:Name="LoginSettingsExpander" Header="登录设置" IsExpanded="False" Margin="0,10,0,0" Foreground="#455D78">
              <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Coder · https://coder.sage.org.ai:9450" FontSize="11" Foreground="#728198" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="用户名" FontSize="11" Margin="0,0,0,5"/>
                    <TextBox x:Name="CredentialUserName" AutomationProperties.Name="Coder 用户名"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="密码（重新输入以保存）" FontSize="11" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="CredentialPassword" Padding="11,9" BorderBrush="#CCD7E6" BorderThickness="1" AutomationProperties.Name="Coder 密码"/>
                  </StackPanel>
                  <Button x:Name="SaveCredentialButton" Grid.Column="2" Content="保存登录凭据" VerticalAlignment="Bottom" IsEnabled="False"/>
                </Grid>
                <TextBlock Text="当前 Windows 用户加密保存；已保存的密码不会显示。" FontSize="11" Foreground="#728198" Margin="0,9,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
        <TextBlock Text="手动更新端口" FontSize="18" FontWeight="SemiBold" Margin="1,0,0,12"/>
        <DockPanel Margin="1,1,1,12">
          <TextBlock x:Name="HostCountText" Text="目标主机" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
          <TextBlock Text="留空即跳过 · 端口范围 1–65535" Foreground="#61748D" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel x:Name="HostsPanel"/>
        <TextBlock Text="仅显示主 config 中直接配置的匹配项；不展开 Include 或 Match。" Foreground="#728198" FontSize="11" Margin="2,0,0,18" TextWrapping="Wrap"/>
        <Border Background="#EAF0FB" CornerRadius="10" Padding="17,14" Margin="0,0,0,17">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,15,0">
              <TextBlock x:Name="SelectionText" Text="填写端口后，在这里预览操作" FontWeight="SemiBold" Foreground="#304F79"/>
              <TextBlock x:Name="PreviewText" Text="确认后自动备份 config，再使用管理员 PowerShell 清除对应记录。" Margin="0,7,0,0" Foreground="#566D8C" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="ApplyButton" Grid.Column="1" Content="确认手动更新" Background="#2864DC" BorderBrush="#2864DC" Foreground="White" FontSize="13" FontWeight="SemiBold" Padding="22,12" IsEnabled="False" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <TextBlock Text="执行结果" FontSize="15" FontWeight="SemiBold" Margin="1,0,0,9"/>
        <TextBox x:Name="ResultText" Text="就绪。输入需要更新的端口，其他主机保持留空。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="115" MaxHeight="210" Background="White" Foreground="#455D78" FontSize="12"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
        <TextBlock x:Name="StatusText" Text="正在读取配置…" Foreground="#526780" TextWrapping="Wrap"/>
        <TextBlock Text="本地同步会先备份 config，再使用管理员 PowerShell 清除对应的旧主机密钥记录。" FontSize="11" Foreground="#7C8BA0" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
