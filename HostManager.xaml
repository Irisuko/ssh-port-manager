<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="管理主机与映射" Width="940" Height="780" MinWidth="800" MinHeight="650"
        WindowStartupLocation="CenterOwner" Background="#F3F6FB"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#15243B">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CCD7E6"/>
      <Setter Property="Foreground" Value="#284464"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#CCD7E6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid Margin="26,23">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="管理主机与映射" FontSize="25" FontWeight="SemiBold"/>
      <TextBlock Text="仅管理本机 SSH 配置中指向 36.140.239.91 的主机及其 Coder 映射。" Foreground="#61748D" Margin="0,8,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="ManagerConfigPathText" Foreground="#728198" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.88*"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,18,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="本地主机" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="ManagerReloadButton" Grid.Column="1" Content="刷新" Margin="0,0,8,0"/>
          <Button x:Name="NewHostButton" Grid.Column="2" Content="新增"/>
        </Grid>
        <ListBox x:Name="ManagerHostList" Grid.Row="1" BorderBrush="#DFE7F1" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="本地 SSH 主机列表">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="8,9">
                <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Connection}" Foreground="#728198" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MappingLabel}" Foreground="#42638B" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding EditHint}" Foreground="#9A6D28" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
          <Border Background="White" BorderBrush="#DFE7F1" BorderThickness="1" CornerRadius="10" Padding="18,16">
            <StackPanel>
              <TextBlock x:Name="ManagerEditorTitle" Text="选择主机，或点击新增" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="SSH 别名" Foreground="#526780" FontSize="12" Margin="0,0,0,5"/>
              <TextBox x:Name="ManagerAliasInput" AutomationProperties.Name="SSH 别名" IsEnabled="False"/>
              <TextBlock Text="HostName · 固定目标 IP" Foreground="#526780" FontSize="12" Margin="0,12,0,5"/>
              <TextBox x:Name="ManagerHostNameInput" Text="36.140.239.91" IsReadOnly="True" Background="#F3F6FB" FontFamily="Consolas" AutomationProperties.Name="固定目标 IP"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                  <TextBlock Text="SSH 用户" Foreground="#526780" FontSize="12" Margin="0,0,0,5"/>
                  <TextBox x:Name="ManagerUserInput" AutomationProperties.Name="SSH 用户" IsEnabled="False"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="端口" Foreground="#526780" FontSize="12" Margin="0,0,0,5"/>
                  <TextBox x:Name="ManagerPortInput" FontFamily="Consolas" AutomationProperties.Name="SSH 端口" IsEnabled="False"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="Coder 工作区名称（可选）" Foreground="#526780" FontSize="12" Margin="0,12,0,5"/>
              <TextBox x:Name="ManagerWorkspaceInput" MaxLength="128" AutomationProperties.Name="Coder 工作区映射" IsEnabled="False"/>
              <TextBlock Text="填写已有工作区名称以绑定；留空解除映射。此处只保存对应关系。" Foreground="#728198" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="ManagerFormHint" Text="别名与用户仅支持英文字母、数字、下划线、点和连字符。" Foreground="#728198" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
              <Grid Margin="0,17,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="DeleteHostButton" Content="删除本地主机" Foreground="#B93838" IsEnabled="False"/>
                <Button x:Name="SaveHostButton" Grid.Column="2" Content="保存主机与映射" Background="#2864DC" Foreground="White" BorderBrush="#2864DC" IsEnabled="False"/>
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="执行结果与备份" FontWeight="SemiBold" Margin="1,15,0,8"/>
          <TextBox x:Name="ManagerResultText" Text="保存前会检查配置是否被其他程序修改，并为改动创建备份。" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="95" MaxHeight="165" Foreground="#455D78" FontSize="11"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ManagerStatusText" Text="正在读取本机配置…" Foreground="#526780" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
      <Button x:Name="CloseManagerButton" Grid.Column="1" Content="完成" MinWidth="90"/>
    </Grid>
  </Grid>
</Window>
